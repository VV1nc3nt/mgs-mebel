# Database (docker-compose.dev.yml)
DATABASE_URL=postgres://mgs:mgs@localhost:5432/mgs

# Payload: long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=

# Public (embedded into the client bundle at build time)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_YMAPS_KEY=

# S3 storage (optional). Without S3_BUCKET media files are stored on disk in ./media
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Media directory for disk storage (default: ./media)
# MEDIA_DIR=
