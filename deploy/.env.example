# /opt/mgs/.env — runtime secrets for the staging stack. Never commit the real file.

# Domain served by Caddy (automatic HTTPS)
SITE_DOMAIN=staging.tmprl.ru

# PostgreSQL. Use URL-safe passwords, e.g. `openssl rand -hex 24`
POSTGRES_USER=mgs
POSTGRES_PASSWORD=
POSTGRES_DB=mgs
DATABASE_URL=postgres://mgs:<POSTGRES_PASSWORD>@postgres:5432/mgs

# Payload: `openssl rand -hex 32`
PAYLOAD_SECRET=

# Basic Auth for the whole site.
# Hash: docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
# Keep the hash in single quotes, otherwise Compose expands the `$` inside it.
BASIC_AUTH_USER=
BASIC_AUTH_HASH=''

# Image tag of the app. Updated automatically by the deploy workflow.
APP_TAG=staging

# S3 storage (optional). Without S3_BUCKET media files are stored in the `media` volume.
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Demo content (staging only): allows deploy/seed.sh, see docs/deploy.md. Never set on production.
# ENABLE_DEMO_SEED=true
