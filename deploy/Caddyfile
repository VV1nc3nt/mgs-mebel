# Staging: public access, automatic HTTPS, no indexing. CMS login is handled by Payload.
# On the server this file lives in /opt/mgs/caddy/Caddyfile.

{$SITE_DOMAIN} {
	encode zstd gzip

	header X-Robots-Tag "noindex, nofollow"

	# Uploads: catalog PDFs up to 100 MB (the app enforces per-type limits).
	request_body {
		max_size 110MB
	}

	reverse_proxy app:3000
}
